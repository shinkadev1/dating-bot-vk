# Токен сообщества ВК (Настройки → Работа с API → Ключи доступа).
# Нужны права: messages, manage.
VK_TOKEN=vk1.a.xxxxxxxx
# Дополнительные сообщества ВК через запятую. VK_TOKEN уже входит в этот список.
# VK_TOKENS=vk1.a.yyyyyyyy,vk1.a.zzzzzzzz

# Тот же секрет, что CHAT_API_SERVICE_TOKEN у Chat API.
# Не короче 16 символов.
CHAT_API_SERVICE_TOKEN=local-service-token-change-me

# Публичный адрес Chat API. События из Redis приходят по WebSocket этого адреса.
# На сервере рядом с Chat API деплой подставляет http://chat-api:8000.
CHAT_API_URL=https://api.chatwithyou.site

# Сеть Compose, в которой работает контейнер vk-chat-api.
# На сервере деплой берёт её из docker inspect. Локально — имя сети Chat API.
CHAT_NETWORK=vk-bot_default

# Сервисный токен Cloudflare Access для api.chatwithyou.site.
# Тот же, что у бота Telegram: политика Access пропускает его на этот адрес.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Прод-образ. Локально не задавайте: Compose соберёт его сам.
# BOT_IMAGE=username/dating-bot:sha

# Заглушка Chat API: True локально, False на проде. Другие значения не включаются.
DEV_MODE=False
#
# Long Poll ВК один на токен. Пока прод слушает основное сообщество, для локального
# бота подставьте токен другого сообщества (например из .env.temp), иначе события
# заберёт локальный процесс.
