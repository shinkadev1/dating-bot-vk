# Токен сообщества ВК (Настройки → Работа с API → Ключи доступа).
# Нужны права: messages, manage.
VK_TOKEN=vk1.a.xxxxxxxx
# Дополнительные сообщества ВК через запятую. VK_TOKEN уже входит в этот список.
# VK_TOKENS=vk1.a.yyyyyyyy,vk1.a.zzzzzzzz

# Тот же секрет, что CHAT_API_SERVICE_TOKEN в репозитории Chat API.
# Не короче 16 символов.
CHAT_API_SERVICE_TOKEN=local-service-token-change-me

# Сеть Docker Compose репозитория Chat API: бот видит сервисы chat-api и redis.
# Локально каталог Chat API называется vk-bot, поэтому сеть vk-bot_default.
# На сервере каталог dating-bot, сеть dating-bot_default — её подставит deploy/update.sh.
CHAT_NETWORK=vk-bot_default

# Адреса внутри сети Chat API. Менять не нужно, пока бот в том же Docker.
CHAT_API_URL=http://chat-api:8000
REDIS_URL=redis://redis:6379/0

# Прод-образ. Локально не задавайте: Compose соберёт его сам.
# BOT_IMAGE=username/dating-bot:sha
